# ─── AgentDNAI Environment Configuration ───────────────────────────────────────
# Copy this file to .env and customize values for your environment.
# NEVER commit your .env file to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite for development, PostgreSQL for production
DATABASE_URL="file:./db/custom.db"

# Production PostgreSQL (uncomment for production):
# DATABASE_URL="postgresql://agentdnai:password@localhost:5432/agentdnai"

# ─── Authentication ────────────────────────────────────────────────────────────
# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Pepper for hashing authentication tokens (generate with: openssl rand -hex 32)
AUTH_PEPPER="change-this-to-a-random-secret-in-production"

# ─── Token Security ────────────────────────────────────────────────────────────
# Pepper for HMAC-SHA256 token hashing (generate with: openssl rand -hex 32)
# IMPORTANT: Changing this invalidates all existing tokens
TOKEN_PEPPER="change-this-to-a-different-random-secret-in-production"

# Maximum TTL for temporary tokens in seconds (default: 86400 = 24h)
MAX_TOKEN_TTL=86400

# Minimum TTL for temporary tokens in seconds (default: 60 = 1min)
MIN_TOKEN_TTL=60

# ─── Cryptography ──────────────────────────────────────────────────────────────
# Key type for agent identity key pair generation
# Options: ed25519, rsa-pss
CRYPTO_KEY_TYPE=ed25519

# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development

# Public-facing URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Allow demo data seeding via /api/seed endpoint (set to false in production)
ALLOW_DEMO_SEED=true

# ─── Audit ─────────────────────────────────────────────────────────────────────
# Enable audit hash chain verification on startup
AUDIT_VERIFY_ON_STARTUP=false

# ─── WebSocket Event Service ──────────────────────────────────────────────────
# Mini-service port for real-time security event notifications (socket.io)
EVENT_SERVICE_PORT=3003
EVENT_SERVICE_HOST="localhost"

# ─── Production Overrides ──────────────────────────────────────────────────────
# Uncomment and configure these for production deployment:

# Redis for session storage and caching
# REDIS_URL="redis://localhost:6379"

# Application URL (used for CORS and redirects)
# APP_URL="https://agentdnai.yourdomain.com"

# CORS allowed origins (comma-separated)
# CORS_ALLOWED_ORIGINS="https://agentdnai.yourdomain.com"

# Enable rate limiting
# RATE_LIMIT_ENABLED=true

# Enable audit chain integrity checking
# AUDIT_CHAIN_ENABLED=true

# Admin email for initial setup
# ADMIN_EMAIL="admin@yourdomain.com"

# Telemetry
NEXT_TELEMETRY_DISABLED=1
