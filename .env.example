# ─── AgentDNAI Environment Configuration ───

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# NextAuth.js (optional — for user authentication)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# WebSocket Event Service (mini-service on port 3003)
EVENT_SERVICE_PORT=3003
EVENT_SERVICE_HOST="localhost"

# Token Security
# Maximum TTL for temporary tokens in seconds (default: 86400 = 24h)
MAX_TOKEN_TTL=86400
# Minimum TTL for temporary tokens in seconds (default: 60 = 1min)
MIN_TOKEN_TTL=60

# Audit
# Enable audit hash chain verification on startup
AUDIT_VERIFY_ON_STARTUP=false
